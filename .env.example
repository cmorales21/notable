# ── Supabase (required — app crashes without these) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Supabase admin (optional — needed only for account deletion) ──────────────
# Without this, DELETE /api/account/delete returns 500 but all other features work.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── TMDB (optional — movie/TV search and IMDb URL extraction return empty without this) ──
TMDB_API_KEY=your-tmdb-api-key

# ── Google Maps (optional — restaurant map embeds are silently disabled without this) ──
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
